# facto-cli — .env.example
#
# The CLI reads almost no env vars at runtime; defaults work for the public
# install flow (`curl -fsSL https://monad-api.facto.to/install | bash`).
#
# Only override these when developing against a non-default backend or
# config dir.
#
# Format per var:
#   # what:     description
#   # source:   where to override / what value to use
#   # required: yes | no
#   # example:  example value
#   KEY=

# what:     Override the default Facto backend URL the CLI calls
# source:   for local dev: http://localhost:8080 (the local facto-engine);
#           for prod default: leave unset, CLI auto-resolves to the active
#           production backend
# required: no
# example:  http://localhost:8080
FACTO_API_URL=
